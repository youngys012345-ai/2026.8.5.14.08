{
  "mode": "design",
  "comment": "Intranet: set mode=run. Use scripts/download_t1.py and download_t3.py.",
  "paths": {
    "public_data": "data/public",
    "features": "data/features",
    "internal_data": "data/internal",
    "outputs": "outputs",
    "third_party": "third_party"
  },
  "hardware": {
    "device": "cuda",
    "gpu_ids": [0],
    "expected_gpus": 8,
    "mixed_precision": false
  },
  "third_party": {
    "ProTAS": {
      "enabled": true,
      "url": "https://github.com/Yuhan-Shen/ProTAS.git",
      "path": "third_party/ProTAS",
      "depth": 1
    },
    "EgoPER_official": {
      "enabled": true,
      "url": "https://github.com/robert80203/EgoPER_official.git",
      "path": "third_party/EgoPER",
      "depth": 1
    },
    "IndustReal": {
      "enabled": true,
      "url": "https://github.com/TimSchoonbeek/IndustReal.git",
      "path": "third_party/IndustReal",
      "depth": 1
    }
  },
  "download_plan": {
    "active_tier": "T1_bootstrap",
    "allow_download": false,
    "prefer_features_over_raw_video": true,
    "min_free_gb": 120,
    "tiers": {
      "T1_bootstrap": {
        "est_gb": [30, 45],
        "min_free_gb": 80,
        "items": ["gtea_mstcn_bundle", "industreal_rgb", "industreal_labels"]
      },
      "T2_core_request": {
        "est_gb": [50, 100],
        "min_free_gb": 150,
        "items": ["gtea_mstcn_bundle", "egoper", "egoprocel_features"]
      },
      "T3_aux_crossview": {
        "est_gb": [20, 200],
        "min_free_gb": 250,
        "items": ["assembly101_features"]
      },
      "T9_avoid_small_disk": {
        "est_gb": [3890, 3890],
        "min_free_gb": 4500,
        "items": ["assembly101_full"]
      }
    }
  },
  "datasets": {
    "gtea_mstcn_bundle": {
      "enabled": true,
      "priority": 1,
      "role": "action_segmentation_features",
      "form": "i3d_features_zip",
      "contains": ["gtea", "50salads", "breakfast"],
      "est_gb": 30,
      "access": "public",
      "download_method": "url",
      "auto_extract": true,
      "page": "https://zenodo.org/records/3625992",
      "url": "https://zenodo.org/records/3625992/files/data.zip?download=1",
      "target_dir": "data/features/mstcn_zenodo",
      "filename": "data.zip",
      "status": "planned",
      "why": "T1 public features for GTEA/50Salads/Breakfast"
    },
    "industreal_rgb": {
      "enabled": true,
      "priority": 2,
      "role": "procedure_rgb",
      "form": "rgb_zip",
      "est_gb": 5,
      "access": "public",
      "download_method": "manual_page",
      "page": "https://data.4tu.nl/datasets/b008dd74-020d-4ea4-a8ba-7bb60769d224",
      "url": "",
      "target_dir": "data/public/industreal",
      "filename": "all_rgb_videos.zip",
      "status": "planned",
      "why": "T1 survey dataset; confirm zip on 4TU page then place into target_dir"
    },
    "industreal_labels": {
      "enabled": true,
      "priority": 2,
      "role": "procedure_labels",
      "form": "labels_zip",
      "est_gb": 0.01,
      "access": "public",
      "download_method": "manual_page",
      "page": "https://data.4tu.nl/datasets/b008dd74-020d-4ea4-a8ba-7bb60769d224",
      "url": "",
      "target_dir": "data/public/industreal",
      "filename": "action_recognition_labels.zip",
      "status": "planned",
      "why": "T1 labels; download from same 4TU page"
    },
    "egoper": {
      "enabled": false,
      "priority": 3,
      "role": "core_A_B",
      "form": "features_preferred",
      "est_gb": 20,
      "access": "request",
      "download_method": "manual_page",
      "request_email": "lee.shih@northeastern.edu",
      "page": "https://github.com/robert80203/EgoPER_official",
      "target_dir": "data/public/egoper",
      "status": "blocked_until_request",
      "why": "T2; email approval required"
    },
    "egoprocel_features": {
      "enabled": false,
      "priority": 4,
      "role": "core_A",
      "form": "features_preferred",
      "est_gb": 40,
      "access": "manual",
      "download_method": "manual_page",
      "page": "https://sid2697.github.io/egoprocel/",
      "target_dir": "data/features/egoprocel",
      "status": "planned_manual",
      "why": "T2 manual features"
    },
    "assembly101_features": {
      "enabled": true,
      "priority": 5,
      "role": "aux_crossview",
      "form": "tsm_features",
      "est_gb": 100,
      "access": "public",
      "download_method": "huggingface",
      "hf_repo_id": "cvml-nus/assembly101",
      "hf_allow_patterns": ["TSM_features/**", "annotations/**"],
      "page": "https://huggingface.co/datasets/cvml-nus/assembly101",
      "target_dir": "data/features/assembly101",
      "filename": "",
      "status": "planned",
      "why": "T3 features only; may require HF account / license accept"
    },
    "assembly101_full": {
      "enabled": false,
      "priority": 99,
      "role": "aux_raw",
      "form": "multi_view_videos",
      "est_gb": 3890,
      "access": "manual",
      "download_method": "manual_page",
      "page": "https://huggingface.co/datasets/cvml-nus/assembly101",
      "target_dir": "data/public/assembly101",
      "status": "avoid",
      "why": "Do not download full recordings on typical disks"
    },
    "virat": {
      "enabled": false,
      "priority": 8,
      "role": "surveillance_person",
      "form": "videos",
      "est_gb": 50,
      "access": "manual",
      "download_method": "manual_page",
      "page": "https://viratdata.org/",
      "target_dir": "data/public/virat",
      "status": "not_primary",
      "why": "Not primary for step segmentation"
    }
  },
  "train": {
    "backend": "ProTAS",
    "dataset": "gtea",
    "split": "1",
    "exp_id": "run0",
    "seed": 42,
    "num_workers": 4,
    "batch_size": 1,
    "epochs": 50,
    "lr": 0.0005,
    "sample_rate": 1,
    "causal": true,
    "use_graph": true,
    "learnable_graph": true,
    "progress_lw": 1.0,
    "graph_lw": 1.0
  },
  "eval": {
    "online": true,
    "metrics": ["frame_acc", "edit", "f1_0.1", "f1_0.25", "f1_0.5"],
    "boundary_deltas_sec": [0.5, 1.0, 2.0],
    "save_dir": "outputs/eval"
  },
  "options": {
    "skip_if_exists": true,
    "dry_run_default": true,
    "require_explicit_execute_flag": true
  }
}
